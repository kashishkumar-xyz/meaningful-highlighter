{
  "manifest_version": 2,
  "name": "Meaningful Highlighter",
  "version": "1.0",
  "description": "Highlights meaningful words and dims filler text using NLP.",
  "permissions": ["activeTab", "tabs"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Meaningful Highlighter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["libs/compromise.min.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}

